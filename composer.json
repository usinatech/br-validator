{
    "name": "usinatech/br-validator",
    "description": "Uma biblioteca de validacoes brasileiras para Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "validation",
        "brasil",
        "cpf",
        "cnpj"
    ],
    "homepage": "https://github.com/UsinaTech/br-validator",
    "support": {
        "issues": "https://github.com/UsinaTech/br-validator/issues",
        "source": "https://github.com/UsinaTech/br-validator"
    },
    "authors": [
        {
            "name": "Alcimar Carlos de Lemos Vasconcelos e Aires",
            "email": "alcimar@usina.tech"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "UsinaTech\\BrValidator\\": "src/br-validator"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/PackageTestCase.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "UsinaTech\\BrValidator\\ValidatorProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
